<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>../../AEther.WinUI/app.manifest</ApplicationManifest>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FluidTestExtensions.cs" Link="FluidTestExtensions.cs" />
    <!-- Forms supplies disposable HWNDs for renderer probes; WinUI owns the app loop. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ApplicationDefinition Include="WindowCheckApplication.xaml" />
    <Page Remove="WindowCheckApplication.xaml" />
    <Compile Remove="build/**/*.cs;artifacts/**/*.cs" />
    <ProjectReference Include="../../AEther.WinUI/AEther.WinUI.csproj" />
  </ItemGroup>
</Project>
