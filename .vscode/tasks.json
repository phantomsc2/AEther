{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build AEther WinUI",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/AEther.WinUI/AEther.WinUI.csproj", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test AEther",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/AEther.Tests/AEther.Tests.csproj"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
